{
  "private": true,
  "name": "devopness-api-docs",
  "version": "1.0.0",
  "description": "Devopness API documentation",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run api-docs && npm run ensure_index_file_is_on_size_limit",
    "copy-local-docs": "cp -R ../devopness-api/docs/api-docs/auto-generated/ ./docs/spec/auto-generated/",
    "api-build-spec": "npm run update-paths-and-schemas && npm run tsc && node ./build/buildApiSpec.js && swagger-cli validate docs/build/api-docs-output.yaml",
    "api-convert-spec-to-dredd": "api-spec-converter --from=openapi_3 --to=swagger_2 --syntax=yaml --order=alpha docs/build/api-docs-output.yaml > docs/build/api-docs-output-v2.yaml",
    "api-convert-spec-to-json": "yaml-convert docs/build/api-docs-output.yaml --pretty --output docs/build/spec.json",
    "api-docs-export-page": "redoc-cli build docs/build/api-docs-output.yaml --title 'Devopness API Docs' --output public/index.html --cdn true -t docs/template.hbs",
    "api-docs-make-description-files": "for endpoint in $(find docs/spec/auto-generated/endpoints -type f); do touch -a docs/spec/descriptions/$(basename ${endpoint%%.yaml}).md; done",
    "api-docs-serve": "npm run api-build-spec && redoc-cli serve docs/build/api-docs-output.yaml --port 9090 --title 'Devopness API Docs - Local' -t docs/template.hbs",
    "api-docs-zip-download": "aws s3 cp s3://devopness-api-docs/api-docs.zip ./docs/api-docs.zip",
    "api-docs-zip-extract": "rm -rf ./docs/spec/auto-generated && extract-zip ./docs/api-docs.zip $(pwd)/docs/spec",
    "api-docs": "npm run api-build-spec && npm run api-convert-spec-to-dredd && npm run api-docs-export-page && npm run api-test",
    "api-test": "npm run tsc && npm run test && npm run remove-descriptions && dredd",
    "update-paths-and-schemas": "rm -rf ./data-models.yaml ./paths.yaml && cp -R ./docs/spec/auto-generated/data-models.yaml ./docs/spec/data-models.yaml && cp -R ./docs/spec/auto-generated/paths.yaml ./docs/spec/paths.yaml",
    "remove-descriptions": "node src/utils/create-dredd-compatible-openapi-v2.js ",
    "remove-descriptions-in-json-spec": "node src/utils/remove-descriptions-in-json-spec.js",
    "ensure_index_file_is_on_size_limit": "[ `du -h public/index.html | grep -oE '^[0-9]+'` -le 7 ]",
    "test": "jest",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devopness/api-docs"
  },
  "author": "devopness",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/devopness/api-docs/issues"
  },
  "homepage": "https://docs.devopness.com/",
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.0",
    "@types/node": "^18.11.9",
    "@types/toposort": "^2.0.7",
    "@types/uuid": "^9.0.8",
    "api-spec-converter": "^2.12.0",
    "dotenv": "^16.4.5",
    "dredd": "^14.1.0",
    "extract-zip": "^2.0.1",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "openapi-types": "^1.3.5",
    "react-is": "^18.2.0",
    "redoc-cli": "^0.13.20",
    "shelljs": "^0.8.5",
    "swagger-cli": "^4.0.4",
    "sync-request": "^6.1.0",
    "toposort": "^2.0.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3",
    "uuid": "^9.0.1",
    "yaml-convert": "^1.0.1"
  }
}
